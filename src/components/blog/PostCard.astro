---
interface Props {
  slug: string;
  title: string;
  date: Date;
  summary: string;
  category: string;
}
const { slug, title, date, summary, category } = Astro.props;
const fmt = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short", day: "numeric" });
const catKey = category.toLowerCase();
---

<a
  href={`/blog/${slug}/`}
  data-bcat-row={catKey}
  class="post-card"
>
  <div class="cat">{category}</div>
  <div class="body">
    <h3>{title}</h3>
    <p>{summary}</p>
    <time datetime={date.toISOString().slice(0, 10)}>{fmt.format(date)}</time>
  </div>
  <span class="arrow" aria-hidden="true">↗</span>
</a>

<style>
  .post-card {
    display: grid;
    grid-template-columns: 160px 1fr 24px;
    gap: 24px;
    padding: 22px 4px;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: inherit;
    align-items: start;
  }
  .post-card:hover h3 { color: var(--accent); }
  .post-card .cat {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accent);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding-top: 4px;
  }
  .post-card h3 {
    font-size: 18px;
    font-weight: 500;
    margin-bottom: 6px;
    color: var(--ink);
    transition: color 120ms ease;
  }
  .post-card p {
    font-size: 14px;
    color: var(--ink-soft);
    margin-bottom: 8px;
    line-height: 1.5;
  }
  .post-card time {
    font-size: 12px;
    color: var(--ink-faint);
  }
  .post-card .arrow {
    color: var(--ink-faint);
    text-align: right;
    padding-top: 4px;
  }
</style>
