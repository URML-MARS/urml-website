---
interface Source {
  title: string;
  url: string;
  accessed: Date;
}
interface Props {
  sources: Source[];
}
const { sources } = Astro.props;
const fmt = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short", day: "numeric" });

function hostname(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return url;
  }
}
---

{sources.length > 0 && (
  <section class="sources">
    <hr />
    <h2>Sources</h2>
    <ol>
      {sources.map((s) => (
        <li>
          <a href={s.url} rel="noopener noreferrer">{s.title}</a>
          <span class="meta"> · {hostname(s.url)} · accessed {fmt.format(s.accessed)}</span>
        </li>
      ))}
    </ol>
  </section>
)}

<style>
  .sources { margin-top: 56px; }
  .sources hr {
    border: 0;
    border-top: 1px solid var(--rule);
    margin-bottom: 28px;
  }
  .sources h2 {
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    font-weight: 600;
    margin-bottom: 18px;
  }
  .sources ol { padding-left: 22px; }
  .sources li {
    margin-bottom: 10px;
    font-size: 14px;
    line-height: 1.5;
  }
  .sources a { color: var(--accent); }
  .sources .meta {
    color: var(--ink-faint);
    font-size: 12px;
  }
</style>
