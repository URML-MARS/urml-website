---
// Five stacked bars = the URML layer stack (L4 -> L0). Top bar accent;
// the rest ink at descending opacity; bottom bar shorter + thinner.
// Ported from the design handoff (source/hifi-shell.jsx HiLogo).
interface Props {
  tone?: "ink" | "bone";
  href?: string;
  animate?: boolean;
}
const { tone = "ink", href = "/", animate = false } = Astro.props;
const fg = tone === "ink" ? "#181715" : "#faf7f1";
const accent = "#cc6b1f";
---

<a class={"hi-logo" + (animate ? " animate" : "")} href={href} aria-label="URML.dev home">
  <svg class="mark" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect x="1" y="3" width="24" height="3" fill={accent} />
    <rect x="1" y="8" width="24" height="3" fill={fg} />
    <rect x="1" y="13" width="24" height="3" fill={fg} opacity="0.8" />
    <rect x="1" y="18" width="24" height="3" fill={fg} opacity="0.55" />
    <rect x="1" y="23" width="19" height="2" fill={fg} opacity="0.3" />
  </svg>
  <span class="wordmark" style={`color:${fg}`}>URML<span class="tld">.dev</span></span>
</a>
