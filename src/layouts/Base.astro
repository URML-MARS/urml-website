---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  active?: string;
}
const {
  title,
  description,
  active = "Home",
} = Astro.props;
// One external resource is permitted in <head>: the self-hosted Umami
// analytics script on our own subdomain (analytics.urml.dev), and only
// when both PUBLIC_UMAMI_* env vars are set at build time. Everything
// else stays first-party (enforced by the netlify.toml CSP, which
// allowlists exactly that one extra origin). Fonts are self-hosted; no
// third-party trackers. The privacy page describes the analytics data
// flow; if you change the behavior here, change /privacy in the same PR.
const umamiHost = import.meta.env.PUBLIC_UMAMI_HOST;
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#181715" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" type="application/rss+xml" title="URML · Notes" href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:image" content={new URL("/og.png", Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="URML.dev · The Universal Robot Language" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og.png", Astro.site).href} />
    <meta name="robots" content="index, follow" />
    {umamiHost && umamiWebsiteId && (
      <script
        defer
        src={`${umamiHost}/script.js`}
        data-website-id={umamiWebsiteId}
        data-domains="urml.dev"
      ></script>
    )}
  </head>
  <body>
    <a href="#main" class="hi-skip">Skip to content</a>
    <Nav active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
