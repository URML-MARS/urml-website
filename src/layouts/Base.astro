---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  active?: string;
}
const {
  title,
  description,
  active = "Home",
} = Astro.props;
// No external resources anywhere in <head>: the repo's hard rule is
// zero third-party network requests at runtime (enforced by the
// netlify.toml CSP). Fonts are self-hosted; no analytics; no trackers.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#181715" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="robots" content="index, follow" />
  </head>
  <body>
    <Nav active={active} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
