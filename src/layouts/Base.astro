---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  active?: string;
}
const {
  title,
  description,
  active = "Home",
} = Astro.props;
// No external resources anywhere in <head>: the repo's hard rule is
// zero third-party network requests at runtime (enforced by the
// netlify.toml CSP). Fonts are self-hosted; no analytics; no trackers.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#181715" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" type="application/rss+xml" title="URML · Notes" href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:image" content={new URL("/og.png", Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="URML.dev · The Universal Robot Language" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og.png", Astro.site).href} />
    <meta name="robots" content="index, follow" />
  </head>
  <body>
    <a href="#main" class="hi-skip">Skip to content</a>
    <Nav active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
