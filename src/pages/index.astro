---
import Base from "../layouts/Base.astro";
import Stat from "../components/Stat.astro";
import Icon from "../components/Icon.astro";
import { reference, parts, manufacturersCount } from "../data/partners";

// Home — the compliance-funnel direction from the handoff
// (source/hifi-home.jsx). HiChrome is intentionally dropped (the
// handoff marks it "do NOT ship"); Nav/Footer live in Base.

// Partners-preview grid: surface 6 reference runtimes + 6 compliant
// parts from the shared directory data so the homepage shows real
// entries instead of [ PARTNER N ] placeholders. Full directory at
// /partners.
const previewCells = [
  ...reference.slice(0, 6).map((r) => ({ label: r.org, sub: r.profiles.join(" · ") })),
  ...parts.slice(0, 6).map((p) => ({ label: p.vendor, sub: p.country })),
];

const steps = [
  { n: "1", t: "Apply", d: "Submit org + product. One form.", s: "Open · 5 min", state: "active" },
  { n: "2", t: "Self-report conformance", d: "Run the conformance suite on your CI.", s: "Hermetic · 10 min", state: "" },
  { n: "3", t: "Manifest review", d: "Capability + provenance audited by the WG.", s: "1 week", state: "" },
  { n: "4", t: "Policy alignment", d: "NDAA §889 · FCC · EO 14307 cross-checked.", s: "Automated + review", state: "" },
  { n: "5", t: "Listed", d: "Appears in the public directory with badge.", s: "Permanent", state: "" },
];

const regs = [
  { code: "NDAA §889 / FY26", t: "Procurement restrictions", d: "Covered-foreign-country components refused at validation, not at audit." },
  { code: "FCC Covered List", t: "Effective 2025-12-23", d: "DJI, Autel, and other listed entities flagged in the manifest pass." },
  { code: "EO 14307", t: "Unleashing American Drone Dominance", d: "Default profile aligns with the executive order's deployment posture." },
  { code: "ASRA", t: "American Security Robotics Act", d: "Tracking the bill. The policy file will update on enactment." },
];

const gets = [
  { icon: "badge", t: "Verifiable badge", d: "Embed on your product page. Links to a live, signed conformance report." },
  { icon: "list", t: "Directory listing", d: "Discoverable by procurement teams searching for URML-compatible robots." },
  { icon: "shield", t: "Federal readiness", d: "Self-reported NDAA / FCC / EO 14307 alignment in one consistent format." },
];

// Code sample as an HTML string so literal { } and newlines are not
// parsed as Astro expressions. white-space:pre in .hi-code renders it.
const codeHtml = `<span class="c"># program.urml.yaml</span>
<span class="k">sequence</span><span class="p">:</span>
  - <span class="k">move_to</span><span class="p">:</span>     { room: kitchen }
  - <span class="k">detect</span><span class="p">:</span>      { object: red_mug, frame: kitchen }
  - <span class="k">grasp</span><span class="p">:</span>       { target: $detected }
  - <span class="k">move_to</span><span class="p">:</span>     { room: living_room }
  - <span class="k">release</span><span class="p">:</span>     { surface: side_table }

<span class="c"># pass 1 ✓ argument typing</span>
<span class="c"># pass 2 ✓ capability declared in manifest</span>
<span class="c"># pass 3 ✓ inside safety envelope</span>
<span class="c"># pass 4 ✓ variable bindings resolve</span>
<span class="c"># pass 5 ✓ compliance policy (NDAA §889, FCC)</span>

<span class="s">$ make demo-run</span>
<span class="p">→ Executed (mock TurtleBot 4 · 18 actions)</span>`;
---

<Base
  title="URML · a common language for the robot economy"
  description="URML is the public spec for robot intent and compliance. One vocabulary for what a robot should do, verified against safety and policy before a single actuator moves."
  active="Home"
>
  {/* ── HERO ─────────────────────────────────────────────────────── */}
  <section class="hi-section" style="padding:88px 56px 96px">
    <div style="display:grid;grid-template-columns:1.15fr 1fr;gap:80px;align-items:start">
      <div>
        <div style="display:flex;gap:10px;margin-bottom:32px;flex-wrap:wrap">
          <span class="hi-chip"><span class="dot"></span>v0.2.0 · Phase 1 · Public draft</span>
          <span class="hi-chip">Apache-2.0</span>
        </div>
        <h1 style="max-width:740px">A common language for the&nbsp;robot&nbsp;economy.</h1>
        <p class="lead" style="margin-top:28px;max-width:600px">
          A six-year-old can describe what a robot should do. A roboticist needs
          three weeks to make the robot do it. URML is the shared, open vocabulary
          that closes the gap, written down before every vendor ships their own dialect.
        </p>
        <div style="display:flex;gap:12px;margin-top:36px;flex-wrap:wrap">
          <a class="hi-btn primary lg" href="#example" style="flex-direction:column;align-items:flex-start;text-align:left;padding-top:14px;padding-bottom:14px">
            <span style="font-size:11px;letter-spacing:0.12em;font-weight:600;color:rgba(250,247,241,0.7);text-transform:uppercase">End users</span>
            <span style="font-size:16px;margin-top:2px">See it run <span class="arrow">→</span></span>
          </a>
          <a class="hi-btn outline lg" href="/spec" style="flex-direction:column;align-items:flex-start;text-align:left;padding-top:14px;padding-bottom:14px">
            <span style="font-size:11px;letter-spacing:0.12em;font-weight:600;color:var(--ink-faint);text-transform:uppercase">Builders</span>
            <span style="font-size:16px;margin-top:2px">Read the spec</span>
          </a>
          <a class="hi-btn outline lg" href="/join" style="flex-direction:column;align-items:flex-start;text-align:left;padding-top:14px;padding-bottom:14px">
            <span style="font-size:11px;letter-spacing:0.12em;font-weight:600;color:var(--ink-faint);text-transform:uppercase">Robot makers</span>
            <span style="font-size:16px;margin-top:2px">List a product</span>
            <span style="font-size:11px;color:var(--ink-faint);margin-top:2px">starts a compliance review</span>
          </a>
        </div>
        <div style="margin-top:14px">
          <a class="hi-btn ghost" href="https://github.com/URML-MARS/URML" rel="noopener noreferrer" style="padding-left:0">
            <Icon name="git" size={16} /> github.com/URML-MARS/URML
          </a>
        </div>
        <div style="margin-top:56px;display:grid;grid-template-columns:1fr 1fr 1fr;gap:40px;max-width:560px">
          <div>
            <div class="caption" style="margin-bottom:6px">SUBSTRATE-AGNOSTIC</div>
            <div class="body-sm" style="color:var(--ink-2)">Sits above ROS 2, PX4, OPC UA, and vendor SDKs.</div>
          </div>
          <div>
            <div class="caption" style="margin-bottom:6px">REGULATOR-ALIGNED</div>
            <div class="body-sm" style="color:var(--ink-2)">Default policy maps to US federal robotics regulation.</div>
          </div>
          <div>
            <div class="caption" style="margin-bottom:6px">OPEN FOREVER</div>
            <div class="body-sm" style="color:var(--ink-2)">Spec stays Apache-2.0. No vendor capture.</div>
          </div>
        </div>
      </div>

      <div class="hi-card" style="padding:36px;position:relative">
        <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:20px">
          <div class="eyebrow">The compliance path</div>
          <div class="caption">~14 days end-to-end</div>
        </div>
        <div class="hi-stepper">
          {steps.map((s) => (
            <div class={"hi-step " + s.state}>
              <div class="num">{s.n}</div>
              <div>
                <div class="title" style="font-size:22px">{s.t}</div>
                <div class="desc">{s.d}</div>
              </div>
              <div class="meta">{s.s}</div>
            </div>
          ))}
        </div>
        <a class="hi-btn dark" href="/join" style="margin-top:24px;width:100%;justify-content:center">
          Start application <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  {/* ── REGULATORY ALIGNMENT ────────────────────────────────────── */}
  <section class="hi-section s tint">
    <div class="head" style="margin-bottom:36px">
      <div class="eyebrow">Regulatory alignment</div>
      <div>
        <h2 class="s" style="max-width:720px">
          The default validator policy is mapped to current US federal robotics regulation.
        </h2>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px">
      {regs.map((r) => (
        <div class="hi-card" style="background:var(--bone)">
          <div class="caption" style="color:var(--accent);margin-bottom:10px">{r.code}</div>
          <div class="mono" style="font-size:14px;font-weight:500;margin-bottom:8px">{r.t}</div>
          <div class="body-sm">{r.d}</div>
        </div>
      ))}
    </div>
    <div class="body-sm" style="margin-top:24px;color:var(--ink-faint)">
      Non-US deployments can override the default with
      <span class="mono" style="color:var(--ink-2)"> urml validate --policy file.yaml</span>, or
      disable the compliance pass entirely with
      <span class="mono" style="color:var(--ink-2)"> --no-policy</span>.
    </div>
  </section>

  {/* ── WHAT YOU GET ─────────────────────────────────────────────── */}
  <section class="hi-section">
    <div class="head">
      <div class="eyebrow">What compliance gets you</div>
      <h2 style="max-width:880px">Discoverable, verifiable, federally-ready.</h2>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:24px">
      {gets.map((c) => (
        <div class="hi-card" style="padding:32px">
          <div style="width:48px;height:48px;border-radius:6px;background:var(--accent-tint);color:var(--accent);display:flex;align-items:center;justify-content:center;margin-bottom:24px">
            <Icon name={c.icon} size={24} />
          </div>
          <h3 style="margin-bottom:10px">{c.t}</h3>
          <p class="body">{c.d}</p>
          <a class="hi-btn ghost" href="/compliance" style="margin-top:18px;padding:0">
            Learn more <span class="arrow">→</span>
          </a>
        </div>
      ))}
    </div>
  </section>

  {/* ── ARCHITECTURE + CODE ──────────────────────────────────────── */}
  <section class="hi-section tint" id="example">
    <div class="head">
      <div class="eyebrow">How URML works</div>
      <h2 style="max-width:920px">Five layers, five validation passes, one program.</h2>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:56px">
      <div>
        <div class="caption" style="margin-bottom:14px">ARCHITECTURE</div>
        <img
          src="/assets/architecture-stack.svg"
          alt="URML architecture: five-layer stack. Layer 4 natural language interface, Layer 3 behavior composition, Layer 2 intent primitives, Layer 1 hardware abstraction, Layer 0 substrate (not part of URML). A validator runs five passes across layers 4 through 1 before any actuator moves. Domain profiles extend layers 3 and 2."
          style="width:100%;height:auto;display:block;border-radius:8px"
          loading="lazy"
        />
        <div class="body-sm" style="margin-top:18px;color:var(--ink-faint)">
          Every program runs through five passes (args → caps → envelope → bindings → policy) before any actuator moves.
        </div>
      </div>
      <div>
        <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:14px">
          <div class="caption">EXAMPLE · BRING ME THE RED MUG</div>
          <div class="caption" style="color:var(--accent)">VALIDATES ✓</div>
        </div>
        <div class="hi-code"><Fragment set:html={codeHtml} /></div>
        <div style="margin-top:18px;display:flex;gap:12px;flex-wrap:wrap">
          <a class="hi-btn outline" href="/spec">Try the demo</a>
          <a class="hi-btn ghost" href="/spec">Read RFC-0002: primitives →</a>
        </div>
      </div>
    </div>
  </section>

  {/* ── STATS ────────────────────────────────────────────────────── */}
  <section class="hi-section s">
    <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:40px">
      <Stat n="24" l="intent primitives" />
      <Stat n="5" l="validation passes" />
      <Stat n="1601" l="tests passing" />
      <Stat n="175" l="conformance fixtures" />
      <Stat n="609" l="RFCs filed" />
    </div>
  </section>

  {/* ── PARTNERS PREVIEW ────────────────────────────────────────── */}
  <section class="hi-section">
    <div class="head" style="align-items:end">
      <div class="eyebrow">Compatible runtimes &amp; partners</div>
      <div style="display:flex;justify-content:space-between;align-items:end;gap:40px">
        <h2 class="s" style="max-width:580px">Self-reported, public, free. Add your organization.</h2>
        <a class="hi-btn outline" href="/partners">Browse directory →</a>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:1px;background:var(--rule);border:1px solid var(--rule)">
      {previewCells.map((c) => (
        <div style="background:var(--bone);height:96px;padding:12px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;font-family:var(--mono);font-size:11px;color:var(--ink);letter-spacing:0.04em;line-height:1.35">
          <div style="font-weight:600;word-break:break-word">{c.label}</div>
          <div style="margin-top:6px;color:var(--ink-faint);font-size:10px;letter-spacing:0.08em;text-transform:uppercase">{c.sub}</div>
        </div>
      ))}
    </div>
    <div class="body-sm" style="margin-top:16px;color:var(--ink-faint)">
      Phase 1 · {reference.length} reference runtimes + {parts.length} compliant parts listed · {manufacturersCount} manufacturers. Yours could be next.
    </div>
  </section>

  {/* ── CTA ──────────────────────────────────────────────────────── */}
  <section class="hi-section dark" style="padding:96px 56px">
    <div style="display:grid;grid-template-columns:1.4fr 1fr;gap:56px;align-items:end">
      <div>
        <div class="eyebrow" style="color:rgba(250,247,241,0.6)">Start the application</div>
        <h2 style="margin-top:16px;color:var(--bone)">Make your robot speak URML.</h2>
        <p class="lead" style="color:rgba(250,247,241,0.8);margin-top:18px;max-width:620px">
          The compliance review is free, opt-in, and self-reported. Your manifest stays yours.
          Listing is permanent until you de-list.
        </p>
      </div>
      <div style="display:flex;flex-direction:column;gap:12px;align-items:flex-end">
        <a class="hi-btn primary lg" href="/join" style="min-width:280px;justify-content:center">
          Apply for compliance review →
        </a>
        <a class="hi-btn outline-on-dark lg" href="/governance" style="min-width:280px;justify-content:center">
          Talk to the working group
        </a>
        <div class="caption" style="color:rgba(250,247,241,0.5);margin-top:8px">
          REVIEWED WITHIN 14 DAYS · NO COST · NO MARK YET (PHASE 4)
        </div>
      </div>
    </div>
  </section>
</Base>
