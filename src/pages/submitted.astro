---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
// Shared success page. Every Netlify form posts here on success
// (action="/submitted"). Static + same-origin, so CSP form-action
// 'self' is satisfied and no client JS is needed.
---

<Base
  title="Received — URML"
  description="Your submission was received. The working group reviews in the open; you'll hear back via the contact you provided."
  active=""
>
  <section class="hi-section" style="padding:120px 56px;text-align:center">
    <div style="width:56px;height:56px;border-radius:50%;background:var(--accent-tint);color:var(--accent);display:flex;align-items:center;justify-content:center;margin:0 auto 28px">
      <Icon name="check" size={28} stroke="currentColor" />
    </div>
    <h1 class="s" style="max-width:640px;margin:0 auto">Received. Thank you.</h1>
    <p class="lead" style="max-width:560px;margin:24px auto 0">
      Your submission reached the working group. Review happens in the open and is time-bound;
      you'll hear back via the contact you provided. There is no account, no fee, and nothing is
      tracked.
    </p>
    <div style="display:flex;gap:12px;justify-content:center;margin-top:36px;flex-wrap:wrap">
      <a class="hi-btn primary" href="/">Back to home</a>
      <a class="hi-btn outline" href="https://github.com/URML-MARS/URML/discussions" rel="noopener noreferrer">Follow Discussions ↗</a>
    </div>
  </section>
</Base>
