---
import Base from "../layouts/Base.astro";
---

<Base
  title="Check your email · URML"
  description="Confirmation email sent. Click the link inside to finish signing up."
  active=""
>
  <section class="hi-section" style="padding:96px 56px;max-width:620px;margin:0 auto">
    <div class="eyebrow" style="margin-bottom:20px">↳ Subscription</div>
    <h1 style="font-size:36px;margin-bottom:18px">Check your email.</h1>
    <p class="lead">
      A confirmation link is on its way. Click it to finish signing up. Until you click the link, no record stays.
    </p>
    <p style="margin-top:24px;color:var(--ink-faint);font-size:14px;line-height:1.6">
      If nothing arrives in a few minutes, check your spam folder. If it really didn't send, the maintainer is logged into the Function dashboard and will see the error, so ping <a href="/contact">contact</a>.
    </p>
    <p style="margin-top:48px;font-size:14px">
      <a href="/blog">← back to the blog</a>
    </p>
  </section>
</Base>
