---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PostCard from "../components/blog/PostCard.astro";
import SignupForm from "../components/SignupForm.astro";

// Blog index. Queries the `blog` content collection (schema in
// src/content/config.ts). Honest empty state when there are no posts.
// Filter island (data-bcat / data-bcat-row) is preserved from the old
// hardcoded-notes version and still works against PostCard's
// data-bcat-row attribute.

const cats: Array<[string, string]> = [
  ["all", "All"],
  ["vendor", "Vendor"],
  ["research", "Research"],
  ["regulation", "Regulation"],
  ["ecosystem", "Ecosystem"],
  ["engineering", "Engineering"],
  ["urml", "URML"],
];

const posts = (await getCollection("blog", ({ data }) => !data.draft || import.meta.env.DEV))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const postCards = posts.map((post) => ({
  slug: post.slug.replace(/^\d{4}-\d{2}-\d{2}-/, ""),
  title: post.data.title,
  date: post.data.date,
  summary: post.data.summary,
  category: post.data.category,
}));
---

<Base
  title="URML notes: short observations on robotics"
  description="Short notes on robotics: vendor moves, research, regulation, ecosystem. URML is one voice. Cadence is irregular."
  active="Blog"
>
  <section class="hi-section" style="padding:72px 56px 48px">
    <div class="eyebrow" style="margin-bottom:24px">↳ Notes · written in the open</div>
    <div style="display:grid;grid-template-columns:1.4fr 1fr;gap:56px;align-items:end">
      <div>
        <h1 class="s" style="max-width:800px">Notes on robotics.</h1>
        <p class="lead" style="margin-top:20px;max-width:580px">
          Short observations on vendor moves, research, regulation, and the wider ecosystem.
          URML is one voice. Cadence is irregular while the project is small. The canonical
          stream is the repo; this is the readable layer on top.
        </p>
      </div>
      <div style="display:flex;flex-direction:column;gap:12px">
        <a class="hi-btn outline" href="/rss.xml">RSS feed</a>
        <a class="hi-btn ghost" href="https://github.com/URML-MARS/URML/discussions" rel="noopener noreferrer">Follow Discussions ↗</a>
      </div>
    </div>
  </section>

  <section style="padding:0 56px 16px;border-bottom:1px solid var(--rule)">
    <div id="bfilter" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
      <span class="caption" style="margin-right:8px">FILTER</span>
      {cats.map(([k, l], i) => (
        <button type="button" data-bcat={k} class="hi-chip" style={"cursor:pointer;padding:5px 14px;" + (i === 0 ? "background:var(--ink);color:var(--bone);border-color:var(--ink)" : "")}>{l}</button>
      ))}
    </div>
  </section>

  <section style="padding:40px 56px 64px">
    {postCards.length > 0 ? (
      <>
        <div class="caption" style="margin-bottom:16px">{postCards.length} {postCards.length === 1 ? "post" : "posts"}</div>
        <div style="border-top:1px solid var(--ink)">
          {postCards.map((p) => (
            <PostCard
              slug={p.slug}
              title={p.title}
              date={p.date}
              summary={p.summary}
              category={p.category}
            />
          ))}
        </div>
        <div data-bempty style="display:none;padding:48px 4px;color:var(--ink-faint);font-family:var(--mono);font-size:13px">No posts in this category yet.</div>
      </>
    ) : (
      <div style="padding:64px 4px;color:var(--ink-faint);font-family:var(--mono);font-size:13px;border-top:1px solid var(--ink)">
        No posts yet.
      </div>
    )}
  </section>

  <section class="hi-section tint">
    <div style="display:grid;grid-template-columns:1.4fr 1fr;gap:56px;align-items:center">
      <div>
        <div class="caption" style="margin-bottom:16px">DIGEST</div>
        <h2 class="s" style="margin-bottom:16px">Sign up for the digest.</h2>
        <p class="body" style="max-width:520px">Confirm via email, then wait. The digest ships when there are posts to summarize and not before. Quiet weeks get skipped, no filler. The canonical stream is always the repo: <a href="/rss.xml">RSS</a> and <a href="https://github.com/URML-MARS/URML/discussions" rel="noopener noreferrer">Discussions</a> on GitHub.</p>
      </div>
      <div class="hi-card" style="padding:28px">
        <SignupForm />
        <div style="display:flex;gap:10px;margin-top:16px">
          <a class="hi-btn outline" href="https://github.com/URML-MARS/URML/releases" rel="noopener noreferrer" style="flex:1;justify-content:center;font-size:13px">Watch releases ↗</a>
          <a class="hi-btn ghost" href="https://github.com/URML-MARS/URML/discussions" rel="noopener noreferrer" style="flex:1;justify-content:center;font-size:13px">Discussions ↗</a>
        </div>
      </div>
    </div>
  </section>

  <section class="hi-section dark" style="padding:72px 56px">
    <div style="display:grid;grid-template-columns:1.4fr 1fr;gap:56px;align-items:center">
      <h2 style="color:var(--bone)">Write the post you wish existed.</h2>
      <div style="display:flex;flex-direction:column;gap:12px">
        <a class="hi-btn primary lg" href="https://github.com/URML-MARS/URML/discussions" rel="noopener noreferrer" style="justify-content:center">Pitch a post →</a>
        <a class="hi-btn outline-on-dark lg" href="https://github.com/URML-MARS/URML" rel="noopener noreferrer" style="justify-content:center">Read the repo</a>
      </div>
    </div>
  </section>
</Base>

<!--
  Category-filter island lives in /public/js/blog-filter.js so the
  strict CSP `script-src 'self'` permits it. Astro inlines small
  <script> blocks by default, which would violate CSP — using an
  external file in /public bypasses that bundling entirely.
-->
<script src="/js/blog-filter.js" defer></script>
