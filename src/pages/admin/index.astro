---
import AdminBase from "../../layouts/AdminBase.astro";

// Blog tab — default landing page when signed in.
// Placeholder shell with Queue / Drafts / Published / Archived subnav.
// Each subview is empty until PR-D (queue CRUD), PR-E (Gemini drafts +
// publish), arrive.

export const prerender = false;

const subviews = [
  { key: "queue", label: "Queue", count: 0, blurb: "Topic queue for the LLM. Manual add/edit. (PR-D)" },
  { key: "drafts", label: "Drafts", count: 0, blurb: "LLM-generated drafts awaiting review. (PR-E)" },
  { key: "published", label: "Published", count: 0, blurb: "Live posts in src/content/blog/. (PR-E)" },
  { key: "archived", label: "Archived", count: 0, blurb: "Removed or de-listed posts. (PR-E)" },
];
---

<AdminBase title="Blog" active="blog">
  <section>
    <h1 style="font-size:28px;margin:0 0 8px">Blog</h1>
    <p style="color:var(--ink-soft);margin:0 0 32px">Topic queue, LLM drafts, and published posts. Subviews appear as the rest of the roadmap lands.</p>

    <div class="subviews">
      {subviews.map((s) => (
        <div class="subview">
          <div class="subview-head">
            <h2>{s.label}</h2>
            <span class="count">{s.count}</span>
          </div>
          <p class="blurb">{s.blurb}</p>
          <div class="empty">Empty.</div>
        </div>
      ))}
    </div>
  </section>
</AdminBase>

<style>
  .subviews {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .subview {
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 20px;
    background: #ffffff;
  }
  .subview-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 6px;
  }
  .subview-head h2 {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
  }
  .count {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 12px;
    color: var(--ink-faint);
    background: var(--bone-2);
    padding: 2px 8px;
    border-radius: 999px;
  }
  .blurb {
    margin: 0 0 16px;
    font-size: 13px;
    color: var(--ink-faint);
    line-height: 1.5;
  }
  .empty {
    padding: 24px 8px;
    text-align: center;
    color: var(--ink-faint);
    font-size: 13px;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    border-top: 1px dashed var(--rule);
  }
</style>
