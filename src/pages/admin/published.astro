---
import AdminBase from "../../layouts/AdminBase.astro";
import BlogSubnav from "../../components/admin/BlogSubnav.astro";
import { listPublishedIndex, type PublishedIndexEntry } from "../../lib/publish";

export const prerender = false;

let entries: PublishedIndexEntry[] = [];
let storeError: string | null = null;
try {
  entries = await listPublishedIndex();
} catch (err) {
  storeError = err instanceof Error ? err.message : String(err);
}

function fmt(iso: string): string {
  try {
    return new Date(iso).toLocaleString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  } catch {
    return iso;
  }
}

function publicUrl(slug: string): string {
  return `/blog/${slug.replace(/^\d{4}-\d{2}-\d{2}-/, "")}/`;
}
---

<AdminBase title="Blog · Published" active="blog">
  <BlogSubnav active="published" />

  <section>
    <h1 style="font-size:28px;margin:0 0 8px">Published</h1>
    <p style="color:var(--ink-soft);margin:0 0 24px;max-width:760px;line-height:1.55">
      Live posts in <code>src/content/blog/</code>. The canonical source is the markdown file in git;
      each row links to the live post, the GitHub commit, and the markdown file on GitHub. To edit
      a published post, edit the markdown file directly via git (or use the GitHub web editor at
      the file link).
    </p>

    {storeError && (
      <div class="published-error">
        <strong>Failed to read published index:</strong> {storeError}
        <p style="margin:6px 0 0;font-size:13px">This is expected on a fresh deploy if no posts have been published yet.</p>
      </div>
    )}

    {!storeError && entries.length === 0 ? (
      <div class="published-empty">
        <strong>No published posts yet.</strong>
        <p style="margin-top:8px">Generate a draft from the <a href="/admin">Queue</a> and click <strong>Publish</strong>.</p>
      </div>
    ) : (
      <table class="published-table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Published</th>
            <th>Links</th>
          </tr>
        </thead>
        <tbody>
          {entries.map((e) => (
            <tr>
              <td class="published-title">
                <a href={publicUrl(e.slug)} target="_blank" rel="noopener noreferrer">{e.title}</a>
                <div class="published-slug">{e.slug}</div>
              </td>
              <td><span class="published-cat">{e.category}</span></td>
              <td class="published-date">{fmt(e.published_at)}</td>
              <td class="published-links">
                {e.github_html_url && (
                  <a href={e.github_html_url} target="_blank" rel="noopener noreferrer">file ↗</a>
                )}
                {e.github_commit_url && (
                  <a href={e.github_commit_url} target="_blank" rel="noopener noreferrer">commit ↗</a>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </section>
</AdminBase>

<style>
  code {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    background: var(--bone-2);
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 13px;
  }
  .published-error {
    padding: 16px 18px;
    background: #fbecdf;
    border: 1px solid var(--accent);
    border-radius: 8px;
    color: var(--ink);
    margin-bottom: 24px;
  }
  .published-empty {
    padding: 56px 16px;
    text-align: center;
    color: var(--ink-faint);
    border: 1px dashed var(--rule);
    border-radius: 8px;
  }
  .published-empty strong { color: var(--ink); }
  .published-empty a { color: var(--accent); font-weight: 500; }

  .published-table {
    width: 100%;
    border-collapse: collapse;
    background: #ffffff;
    border: 1px solid var(--rule);
    border-radius: 8px;
    overflow: hidden;
  }
  .published-table th,
  .published-table td {
    padding: 14px 16px;
    text-align: left;
    border-bottom: 1px solid var(--rule);
    font-size: 14px;
    vertical-align: top;
  }
  .published-table th {
    background: var(--bone-2);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    font-weight: 600;
  }
  .published-table tr:last-child td { border-bottom: 0; }
  .published-title a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }
  .published-title a:hover { color: var(--accent); }
  .published-slug {
    margin-top: 4px;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 11px;
    color: var(--ink-faint);
  }
  .published-cat {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--bone-2);
    color: var(--accent);
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }
  .published-date {
    color: var(--ink-soft);
    font-size: 13px;
  }
  .published-links {
    display: flex;
    gap: 12px;
    font-size: 13px;
  }
  .published-links a {
    color: var(--accent);
    text-decoration: none;
  }
  .published-links a:hover { text-decoration: underline; }
</style>
