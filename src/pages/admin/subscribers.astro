---
import AdminBase from "../../layouts/AdminBase.astro";
import { subscribersStore, type Subscriber } from "../../lib/subscribers";

// Subscribers tab — read-only list, queried server-side from Blobs.
// PR-G adds CSV export, manual unsubscribe, and digest history.

export const prerender = false;

interface Row {
  token: string;
  email: string;
  status: Subscriber["status"];
  created_at: string;
  confirmed_at?: string;
}

let rows: Row[] = [];
let storeError: string | null = null;

try {
  const store = subscribersStore();
  // .list() returns { blobs: [{ key, etag }] }. Iterate and fetch.
  const listing = await store.list();
  for (const blob of listing.blobs) {
    const sub = (await store.get(blob.key, { type: "json" })) as Subscriber | null;
    if (!sub) continue;
    rows.push({
      token: blob.key,
      email: sub.email,
      status: sub.status,
      created_at: sub.created_at,
      confirmed_at: sub.confirmed_at,
    });
  }
  rows.sort((a, b) => b.created_at.localeCompare(a.created_at));
} catch (err) {
  storeError = err instanceof Error ? err.message : String(err);
  console.warn("[admin/subscribers] Blobs read failed:", storeError);
}

function fmt(iso: string): string {
  try {
    return new Date(iso).toLocaleString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  } catch {
    return iso;
  }
}

function maskEmail(email: string): string {
  // Hash-mask in v1: show first 2 chars and domain only. Toggle for full
  // email is PR-G work.
  const at = email.indexOf("@");
  if (at < 0) return email;
  const local = email.slice(0, at);
  const domain = email.slice(at);
  const visible = local.slice(0, Math.min(2, local.length));
  return `${visible}${"•".repeat(Math.max(local.length - 2, 1))}${domain}`;
}

const counts = {
  total: rows.length,
  pending: rows.filter((r) => r.status === "pending").length,
  confirmed: rows.filter((r) => r.status === "confirmed").length,
  unsubscribed: rows.filter((r) => r.status === "unsubscribed").length,
};
---

<AdminBase title="Subscribers" active="subscribers">
  <section>
    <h1 style="font-size:28px;margin:0 0 8px">Subscribers</h1>
    <p style="color:var(--ink-soft);margin:0 0 24px">Read-only at this PR. CSV export, manual unsubscribe, and digest controls land in PR-G.</p>

    <div class="counts">
      <div class="count-card"><div class="n">{counts.total}</div><div class="l">total</div></div>
      <div class="count-card"><div class="n">{counts.confirmed}</div><div class="l">confirmed</div></div>
      <div class="count-card"><div class="n">{counts.pending}</div><div class="l">pending</div></div>
      <div class="count-card"><div class="n">{counts.unsubscribed}</div><div class="l">unsubscribed</div></div>
    </div>

    {storeError && (
      <div class="error">
        <strong>Blobs read failed:</strong> {storeError}
        <p style="margin:8px 0 0;font-size:13px">This is expected if the Netlify Blobs store has not been initialized yet (no signups have happened on this deploy).</p>
      </div>
    )}

    {!storeError && rows.length === 0 ? (
      <div class="empty">No subscribers yet.</div>
    ) : (
      <table class="rows">
        <thead>
          <tr>
            <th>Email</th>
            <th>Status</th>
            <th>Signed up</th>
            <th>Confirmed</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td class="email" title={r.email}>{maskEmail(r.email)}</td>
              <td><span class={`pill pill-${r.status}`}>{r.status}</span></td>
              <td class="ts">{fmt(r.created_at)}</td>
              <td class="ts">{r.confirmed_at ? fmt(r.confirmed_at) : "—"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </section>
</AdminBase>

<style>
  .counts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 24px;
  }
  .count-card {
    padding: 16px;
    background: #ffffff;
    border: 1px solid var(--rule);
    border-radius: 8px;
  }
  .count-card .n {
    font-size: 28px;
    font-weight: 600;
    color: var(--ink);
  }
  .count-card .l {
    margin-top: 4px;
    font-size: 12px;
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .error {
    padding: 16px 18px;
    background: #fbecdf;
    border: 1px solid var(--accent);
    border-radius: 8px;
    color: var(--ink);
    margin-bottom: 24px;
  }
  .empty {
    padding: 56px 16px;
    text-align: center;
    color: var(--ink-faint);
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    border: 1px dashed var(--rule);
    border-radius: 8px;
  }
  table.rows {
    width: 100%;
    border-collapse: collapse;
    background: #ffffff;
    border: 1px solid var(--rule);
    border-radius: 8px;
    overflow: hidden;
  }
  table.rows th, table.rows td {
    padding: 12px 16px;
    text-align: left;
    border-bottom: 1px solid var(--rule);
    font-size: 14px;
  }
  table.rows th {
    background: var(--bone-2);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    font-weight: 600;
  }
  table.rows tr:last-child td { border-bottom: 0; }
  td.email {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 13px;
  }
  td.ts {
    font-size: 13px;
    color: var(--ink-soft);
  }
  .pill {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .pill-confirmed { background: #d8e8d4; color: #2e5a2a; }
  .pill-pending { background: #fbecdf; color: #8a4a14; }
  .pill-unsubscribed { background: var(--bone-2); color: var(--ink-faint); }
</style>
