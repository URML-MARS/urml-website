---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
// Partners — design shell from hifi-partners.jsx, content reconciled
// with the live registry reality (docs/compatible-runtimes.md):
// self-reported, URML does NOT certify/audit/endorse, third-party
// registry is EMPTY. The reference runtimes are first-party and real
// (built in the core repo this session); they pass the conformance
// suite hermetically. No invented "verified/founding" tiers or dates.
// Tab + profile filter is a CSP-safe bundled island.

const reference = [
  { org: "urml-ros2-runtime", sub: "ROS 2 · Nav2 / MoveIt 2 / vision_msgs", profiles: ["home", "industrial"], note: "First-party reference adapter · hermetic conformance" },
  { org: "urml-px4-runtime", sub: "PX4 / MAVLink via pymavlink · no ROS dependency", profiles: ["drone"], note: "First-party reference adapter · hermetic conformance" },
  { org: "urml-industrial-arm-runtime", sub: "ROS-Industrial / MoveIt 2 · ABB · FANUC · KUKA · YASKAWA · UR · Franka · Kawasaki · Stäubli · Comau · Mitsubishi Electric · Denso · Hyundai · Nachi · Epson · Omron · Hanwha (16 brands)", profiles: ["industrial"], note: "First-party reference adapter · hermetic conformance" },
  { org: "urml-cobot-runtime", sub: "Native zero-ROS cobot SDKs · UR RTDE · Franka FCI · Doosan DRFL · Techman TMflow · Kinova Kortex · Mecademic · Neura · Kassow (8 brands)", profiles: ["industrial"], note: "First-party reference adapter · hermetic conformance" },
  { org: "urml-legged-runtime", sub: "Boston Dynamics Spot (bosdyn) · ANYbotics ANYmal (ROS 2)", profiles: ["industrial"], note: "First-party reference adapter · hermetic conformance" },
  { org: "urml-humanoid-runtime", sub: "Agility Digit (ROS 2 · locomotion subset)", profiles: ["industrial"], note: "First-party reference adapter · hermetic conformance" },
  { org: "urml-mobile-runtime", sub: "Clearpath Husky / Jackal · ROS 2 + Nav2", profiles: ["home", "industrial"], note: "First-party reference adapter · hermetic conformance" },
  { org: "urml-marine-runtime", sub: "BlueROV2 / ArduSub via MAVLink · no ROS dependency", profiles: ["drone"], note: "First-party reference adapter · hermetic conformance" },
  { org: "urml-opcua-runtime", sub: "OPC UA Robotics companion spec via asyncua · zero ROS · RFC-0015/0016 spec-gaps filed", profiles: ["industrial"], note: "First-party reference adapter · hermetic conformance" },
  { org: "urml-mujoco-runtime", sub: "MuJoCo physics simulator · zero ROS · pure Protocol proof", profiles: ["home"], note: "First-party reference adapter · hermetic conformance" },
  { org: "urml-isaac-runtime", sub: "NVIDIA Isaac Sim/Lab · zero ROS · local RTX/Omniverse (not cloud)", profiles: ["home"], note: "First-party reference adapter · hermetic conformance" },
  { org: "urml-embedded-runtime", sub: "micro:bit/Arduino over pyserial · zero ROS · RFC-0011 educational", profiles: ["home"], note: "First-party reference adapter · hermetic conformance" },
  { org: "urml-edu-runtime", sub: "VEX V5 · LEGO SPIKE (Pybricks BLE) · Thymio (Aseba TDM) · zero ROS · RFC-0011 educational (3 platforms)", profiles: ["home"], note: "First-party reference adapter · hermetic conformance" },
  { org: "urml-autosar-runtime", sub: "AUTOSAR Adaptive ara::com scaffold · zero ROS · RFC-0019 Draft binding", profiles: ["industrial"], note: "First-party reference adapter · hermetic conformance · scaffold only" },
];

// First-party compliant-part reference manifests. URML ships a YAML manifest
// fixture + a positive conformance fixture for each vendor below; all pass
// the bundled US-federal default compliance policy (RFC-0004). Vendors marked
// with a Move #1 RFC are also subjects of a vendor-directed mapping RFC
// (RFCs 0023-0038) requesting maintainer feedback.
const parts = [
  { vendor: "SCHUNK", country: "DE", kind: "Pneumatic gripper (MPG / MPP)", manifest: "schunk_mpg_cell.yaml", rfc: "0031" },
  { vendor: "Ouster", country: "US", kind: "3D lidar (OS-1 / OS-2 / REV7)", manifest: "ouster_3d_lidar_cell.yaml", rfc: "0032" },
  { vendor: "SICK", country: "DE", kind: "Safety lidar (microScan3 / nanoScan3)", manifest: "sick_safety_lidar_cell.yaml", rfc: "0033" },
  { vendor: "Festo", country: "DE", kind: "Servo-electric gripper (DHEP / DHPS)", manifest: "festo_dhep_cell.yaml", rfc: "0034" },
  { vendor: "Zivid", country: "NO", kind: "3D industrial camera (Zivid Two / 2+)", manifest: "zivid_two_cell.yaml", rfc: "0035" },
  { vendor: "Hokuyo", country: "JP", kind: "2D lidar (URG / UST / UTM)", manifest: "hokuyo_lidar_cell.yaml", rfc: "0036" },
  { vendor: "Robotiq", country: "CA", kind: "Servo-electric gripper (2F-85)", manifest: "robotiq_2f85_cell.yaml" },
  { vendor: "Piab", country: "SE", kind: "Vacuum gripper", manifest: "piab_vacuum_cell.yaml" },
  { vendor: "OnRobot", country: "DK", kind: "Magnetic gripper", manifest: "onrobot_magnetic_cell.yaml" },
  { vendor: "Soft Robotics", country: "US", kind: "Compliant gripper", manifest: "soft_robotics_compliant_cell.yaml" },
  { vendor: "ATI Industrial Automation", country: "US", kind: "Force-torque (Axia80)", manifest: "ati_ft_cell.yaml" },
  { vendor: "Cognex", country: "US", kind: "Industrial vision (In-Sight 2800)", manifest: "cognex_vision_cell.yaml" },
  { vendor: "Schmalz", country: "DE", kind: "Vacuum gripper", manifest: "schmalz_vacuum_cell.yaml" },
  { vendor: "Bota Systems", country: "CH", kind: "6-axis force-torque", manifest: "bota_ft_cell.yaml" },
  { vendor: "Photoneo", country: "SK", kind: "3D structured-light vision (MotionCam-3D)", manifest: "photoneo_motioncam_cell.yaml" },
];

const profiles = ["all", "home", "drone", "industrial"];
---

<Base
  title="URML partners & adopters — a public, self-reported directory"
  description="Every runtime and robot that has self-reported URML compatibility. Free, opt-in, de-listable any time. URML does not certify, audit, or endorse listed entries."
  active="Partners"
>
  <section class="hi-section" style="padding:72px 56px 48px">
    <div class="eyebrow" style="margin-bottom:24px">↳ Public directory · self-reported</div>
    <div style="display:grid;grid-template-columns:1.4fr 1fr;gap:56px;align-items:end">
      <div>
        <h1 class="s" style="max-width:820px">Partners &amp; adopters.</h1>
        <p class="lead" style="margin-top:24px;max-width:620px">
          Every runtime, robot, and integrator that has self-reported URML compatibility lives
          here. Free, opt-in, de-listable any time. URML does not certify, audit, or endorse
          listed entries; a listing reflects only a submitted, reproducible result. The first-party
          reference runtimes seed the list; yours can be next.
        </p>
      </div>
      <div class="hi-card" style="padding:24px">
        <div class="eyebrow" style="margin-bottom:14px">Directory at a glance</div>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px">
          <div class="hi-stat"><div class="n" style="font-size:40px">14</div><div class="l">reference runtimes</div></div>
          <div class="hi-stat"><div class="n" style="font-size:40px">15</div><div class="l">compliant parts</div></div>
          <div class="hi-stat"><div class="n" style="font-size:40px">0</div><div class="l">manufacturers</div></div>
        </div>
        <hr class="hi-rule" style="margin:16px 0" />
        <a class="hi-btn primary" href="/join" style="width:100%;justify-content:center">Add your organization →</a>
      </div>
    </div>
  </section>

  <section class="hi-section" style="padding:0 56px 32px">
    <div class="hi-card" style="padding:24px 28px;background:var(--bone-2);border-left:3px solid var(--accent)">
      <div class="caption" style="margin-bottom:10px;color:var(--accent)">↳ MOVE #1 LIGHTHOUSE PROGRAM · 2026-05-22</div>
      <div style="display:grid;grid-template-columns:1.4fr 1fr;gap:32px;align-items:start">
        <div>
          <div style="font-size:18px;font-weight:500;color:var(--ink);margin-bottom:8px">16 vendor-directed mapping RFCs filed.</div>
          <p class="body-sm" style="color:var(--ink-soft);margin:0">
            URML has published one mapping RFC per Tier-1 vendor (RFCs 0023–0038), each framed as a public request for comment from that vendor's maintainers. The artifacts are in-repo; the conversations are open. URML does not certify, audit, or endorse any listed vendor; each RFC documents URML's side of the mapping and invites correction.
          </p>
        </div>
        <div style="font-family:var(--mono);font-size:11px;line-height:1.8;color:var(--ink-soft)">
          <a href="https://github.com/URML-MARS/URML/blob/main/docs/rfcs/0023-yaskawa-motoros2-integration.md" style="color:var(--ink);text-decoration:none">0023 · Yaskawa</a> ·
          <a href="https://github.com/URML-MARS/URML/blob/main/docs/rfcs/0024-universal-robots-integration.md" style="color:var(--ink);text-decoration:none">0024 · UR</a> ·
          <a href="https://github.com/URML-MARS/URML/blob/main/docs/rfcs/0025-kuka-integration.md" style="color:var(--ink);text-decoration:none">0025 · KUKA</a> ·
          <a href="https://github.com/URML-MARS/URML/blob/main/docs/rfcs/0026-staubli-integration.md" style="color:var(--ink);text-decoration:none">0026 · Stäubli</a> ·
          <a href="https://github.com/URML-MARS/URML/blob/main/docs/rfcs/0027-mitsubishi-melfa-integration.md" style="color:var(--ink);text-decoration:none">0027 · Mitsubishi</a> ·
          <a href="https://github.com/URML-MARS/URML/blob/main/docs/rfcs/0028-fanuc-integration.md" style="color:var(--ink);text-decoration:none">0028 · FANUC</a> ·
          <a href="https://github.com/URML-MARS/URML/blob/main/docs/rfcs/0029-kawasaki-integration.md" style="color:var(--ink);text-decoration:none">0029 · Kawasaki</a> ·
          <a href="https://github.com/URML-MARS/URML/blob/main/docs/rfcs/0030-denso-integration.md" style="color:var(--ink);text-decoration:none">0030 · Denso</a>
          <br>
          <a href="https://github.com/URML-MARS/URML/blob/main/docs/rfcs/0031-schunk-integration.md" style="color:var(--ink);text-decoration:none">0031 · SCHUNK</a> ·
          <a href="https://github.com/URML-MARS/URML/blob/main/docs/rfcs/0032-ouster-integration.md" style="color:var(--ink);text-decoration:none">0032 · Ouster</a> ·
          <a href="https://github.com/URML-MARS/URML/blob/main/docs/rfcs/0033-sick-integration.md" style="color:var(--ink);text-decoration:none">0033 · SICK</a> ·
          <a href="https://github.com/URML-MARS/URML/blob/main/docs/rfcs/0034-festo-integration.md" style="color:var(--ink);text-decoration:none">0034 · Festo</a> ·
          <a href="https://github.com/URML-MARS/URML/blob/main/docs/rfcs/0035-zivid-integration.md" style="color:var(--ink);text-decoration:none">0035 · Zivid</a> ·
          <a href="https://github.com/URML-MARS/URML/blob/main/docs/rfcs/0036-hokuyo-integration.md" style="color:var(--ink);text-decoration:none">0036 · Hokuyo</a> ·
          <a href="https://github.com/URML-MARS/URML/blob/main/docs/rfcs/0037-osrf-gazebo-integration.md" style="color:var(--ink);text-decoration:none">0037 · OSRF / Gazebo</a> ·
          <a href="https://github.com/URML-MARS/URML/blob/main/docs/rfcs/0038-ros-industrial-consortium.md" style="color:var(--ink);text-decoration:none">0038 · ROS-Industrial</a>
        </div>
      </div>
    </div>
  </section>

  <section style="padding:0 56px;border-bottom:1px solid var(--rule)">
    <div id="ptabs" style="display:flex;gap:0">
      <button type="button" data-ptab="runtimes" aria-pressed="true" style="background:transparent;border:0;border-bottom:2px solid var(--accent);padding:20px 28px;font-family:var(--sans);font-size:16px;font-weight:500;color:var(--ink);cursor:pointer;display:flex;align-items:center;gap:10px;margin-bottom:-1px">
        Runtimes <span class="mono" style="font-size:11px;background:var(--accent);color:var(--bone);padding:2px 8px;border-radius:999px">14</span>
      </button>
      <button type="button" data-ptab="parts" aria-pressed="false" style="background:transparent;border:0;border-bottom:2px solid transparent;padding:20px 28px;font-family:var(--sans);font-size:16px;font-weight:500;color:var(--ink-soft);cursor:pointer;display:flex;align-items:center;gap:10px;margin-bottom:-1px">
        Compliant parts <span class="mono" style="font-size:11px;background:var(--bone-2);color:var(--ink-soft);padding:2px 8px;border-radius:999px">15</span>
      </button>
      <button type="button" data-ptab="manufacturers" aria-pressed="false" style="background:transparent;border:0;border-bottom:2px solid transparent;padding:20px 28px;font-family:var(--sans);font-size:16px;font-weight:500;color:var(--ink-soft);cursor:pointer;display:flex;align-items:center;gap:10px;margin-bottom:-1px">
        Manufacturers <span class="mono" style="font-size:11px;background:var(--bone-2);color:var(--ink-soft);padding:2px 8px;border-radius:999px">0</span>
      </button>
    </div>
  </section>

  <section data-filter-bar style="padding:20px 56px;background:var(--bone-2);border-bottom:1px solid var(--rule)">
    <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap">
      <div class="caption" style="color:var(--ink-faint)">FILTER</div>
      <span class="body-sm" style="color:var(--ink-soft)">Profile:</span>
      <div id="pfilter" style="display:flex;gap:8px;flex-wrap:wrap">
        {profiles.map((opt, i) => (
          <button type="button" data-prof={opt} class="hi-chip" style={"cursor:pointer;" + (i === 0 ? "background:var(--ink);color:var(--bone);border-color:var(--ink)" : "")}>{opt}</button>
        ))}
      </div>
      <span class="body-sm" style="color:var(--ink-faint);margin-left:auto">Filter applies to reference runtimes.</span>
    </div>
  </section>

  <section class="hi-section" data-pane="runtimes" style="padding:40px 56px 56px">
    <div style="display:grid;grid-template-columns:1.8fr 1fr 1.4fr 24px;gap:20px;padding:10px 16px;border-bottom:1px solid var(--ink);font-family:var(--mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-soft);font-weight:500">
      <span>Reference runtime</span><span>Profile</span><span>Status</span><span></span>
    </div>
    {reference.map((r) => (
      <a href="https://github.com/URML-MARS/URML/tree/main/reference" rel="noopener noreferrer" data-prof-row={r.profiles.join(",")} style="display:grid;grid-template-columns:1.8fr 1fr 1.4fr 24px;gap:20px;padding:20px 16px;border-bottom:1px solid var(--rule);text-decoration:none;color:inherit;align-items:center">
        <div>
          <div class="mono" style="font-weight:600;font-size:15px;color:var(--ink)">{r.org}</div>
          <div class="body-sm" style="margin-top:4px">{r.sub}</div>
          <div class="mono" style="font-size:11px;color:var(--ink-faint);margin-top:6px">{r.note}</div>
        </div>
        <div style="display:flex;gap:6px;flex-wrap:wrap">
          {r.profiles.map((p) => <span class="hi-chip" style="font-size:10px;padding:2px 8px">{p}</span>)}
        </div>
        <span style="font-family:var(--mono);font-size:11px;color:var(--accent);display:flex;gap:6px;align-items:center">
          <Icon name="check" size={12} stroke="currentColor" /> FIRST-PARTY · HERMETIC
        </span>
        <span style="color:var(--ink-faint);text-align:right">↗</span>
      </a>
    ))}
    <div data-empty style="display:none;padding:48px 16px;color:var(--ink-faint);font-family:var(--mono);font-size:13px">No reference runtime matches that profile filter.</div>

    <div class="hi-card" style="margin-top:32px;padding:28px;background:var(--ink);color:var(--bone);border-color:var(--ink);display:grid;grid-template-columns:1.4fr 1fr;gap:32px;align-items:center">
      <div>
        <div class="caption" style="color:rgba(250,247,241,0.5);margin-bottom:8px">RUNTIME AUTHORS</div>
        <h3 style="font-size:28px;color:var(--bone);margin-bottom:6px">You don't need permission to list.</h3>
        <p class="body-sm" style="color:rgba(250,247,241,0.7)">Run the conformance suite, open a PR to <span class="mono" style="color:var(--bone)">docs/compatible-runtimes.md</span>. Self-reported; URML does not certify or endorse.</p>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px">
        <a class="hi-btn primary" href="/join" style="justify-content:center">Submit your runtime →</a>
        <a class="hi-btn outline-on-dark" href="/compliance" style="justify-content:center">Read the 5-step guide</a>
      </div>
    </div>
  </section>

  <section class="hi-section" data-pane="parts" style="padding:40px 56px 56px;display:none">
    <div class="hi-card" style="margin:0 0 24px;padding:20px 24px;background:var(--bone-2)">
      <p class="body-sm" style="margin:0;color:var(--ink-soft)">
        Each row below is a URML-authored reference manifest for a vendor's part, validated under URML's bundled US-federal default compliance policy (<a href="https://github.com/URML-MARS/URML/blob/main/docs/rfcs/0004-compliance-policy.md" style="color:var(--accent)">RFC-0004</a>). Rows marked with a Move #1 RFC link to a vendor-directed mapping RFC requesting maintainer feedback. The Manufacturers tab remains the path for vendors who want to self-report; this tab is URML's own first-party reference manifests.
      </p>
    </div>
    <div style="display:grid;grid-template-columns:1.6fr 0.6fr 1.6fr 0.8fr 24px;gap:20px;padding:10px 16px;border-bottom:1px solid var(--ink);font-family:var(--mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-soft);font-weight:500">
      <span>Vendor</span><span>Origin</span><span>Part kind</span><span>Move #1 RFC</span><span></span>
    </div>
    {parts.map((p) => (
      <a href={p.rfc ? `https://github.com/URML-MARS/URML/blob/main/docs/rfcs/${p.rfc}-${p.vendor.toLowerCase().replace(/[^a-z0-9]+/g, "-")}-integration.md` : `https://github.com/URML-MARS/URML/blob/main/reference/validator/tests/fixtures/manifests/${p.manifest}`} rel="noopener noreferrer" style="display:grid;grid-template-columns:1.6fr 0.6fr 1.6fr 0.8fr 24px;gap:20px;padding:20px 16px;border-bottom:1px solid var(--rule);text-decoration:none;color:inherit;align-items:center">
        <div>
          <div class="mono" style="font-weight:600;font-size:15px;color:var(--ink)">{p.vendor}</div>
          <div class="mono" style="font-size:11px;color:var(--ink-faint);margin-top:6px">{p.manifest}</div>
        </div>
        <div class="mono" style="font-size:12px;color:var(--ink-soft)">{p.country}</div>
        <div class="body-sm" style="color:var(--ink-soft)">{p.kind}</div>
        <div style="font-family:var(--mono);font-size:11px">
          {p.rfc
            ? <span style="color:var(--accent)">RFC-{p.rfc}</span>
            : <span style="color:var(--ink-faint)">manifest only</span>}
        </div>
        <span style="color:var(--ink-faint);text-align:right">↗</span>
      </a>
    ))}

    <div class="hi-card" style="margin-top:32px;padding:28px;background:var(--ink);color:var(--bone);border-color:var(--ink);display:grid;grid-template-columns:1.4fr 1fr;gap:32px;align-items:center">
      <div>
        <div class="caption" style="color:rgba(250,247,241,0.5);margin-bottom:8px">PART VENDORS</div>
        <h3 style="font-size:28px;color:var(--bone);margin-bottom:6px">Your part already integrates.</h3>
        <p class="body-sm" style="color:rgba(250,247,241,0.7)">If your part is on this list and you want a vendor-direct mapping RFC (or to correct the existing one), open an Issue against URML or contact the maintainer. URML is in Phase 0; feedback shapes the spec.</p>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px">
        <a class="hi-btn primary" href="https://github.com/URML-MARS/URML/discussions" style="justify-content:center" rel="noopener noreferrer">Open a discussion →</a>
        <a class="hi-btn outline-on-dark" href="/compliance" style="justify-content:center">Read the parts guide</a>
      </div>
    </div>
  </section>

  <section class="hi-section" data-pane="manufacturers" style="padding:40px 56px 56px;display:none">
    <div style="padding:80px 32px;border:1.5px dashed var(--rule);border-radius:8px;text-align:center;margin:16px 0;background:var(--bone-2)">
      <div style="width:56px;height:56px;border-radius:50%;background:var(--bone);border:1.5px solid var(--rule);margin:0 auto 24px;display:flex;align-items:center;justify-content:center;color:var(--accent)">
        <Icon name="badge" size={28} stroke="currentColor" />
      </div>
      <h3 style="font-size:28px;margin-bottom:10px">No manufacturers listed yet.</h3>
      <p class="body" style="max-width:520px;margin:0 auto 24px">The directory is open and empty. If you build robots, end-effectors, or sub-assemblies and want federal-procurement visibility, you would be the first.</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a class="hi-btn primary" href="/join">Become the first listing →</a>
        <a class="hi-btn outline" href="/compliance">Read the manufacturer guide</a>
      </div>
    </div>
  </section>

  <section class="hi-section dark" style="padding:80px 56px">
    <div style="display:grid;grid-template-columns:1.4fr 1fr;gap:56px;align-items:center">
      <div>
        <div class="eyebrow" style="color:rgba(250,247,241,0.6);margin-bottom:16px">JOIN THE DIRECTORY</div>
        <h2 style="color:var(--bone)">Phase 0 is the best time to list.</h2>
        <p class="lead" style="color:rgba(250,247,241,0.7);margin-top:16px;max-width:540px">Listings are permanent until you de-list. No waitlist, no fee, no mark — and no endorsement implied.</p>
      </div>
      <div style="display:flex;flex-direction:column;gap:12px">
        <a class="hi-btn primary lg" href="/join" style="justify-content:center">List your runtime →</a>
        <a class="hi-btn outline-on-dark lg" href="/join" style="justify-content:center">List your robot →</a>
      </div>
    </div>
  </section>
</Base>

<!-- External script lives in /public/js/partners.js to comply with the
     netlify.toml CSP (`script-src 'self'`, no `'unsafe-inline'`). Astro
     silently inlines small <script> blocks despite the no-inline policy
     comment in netlify.toml; serving the JS as a static asset under
     /public sidesteps that. Behaviour is identical to the prior inline
     block (tabs + profile-filter island, idempotent on click). -->
<script src="/js/partners.js" type="module" defer is:inline></script>
