---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
// Spec — ported from the handoff (source/hifi-spec.jsx). HiCodeTabs is
// a real island here, implemented as a bundled (CSP-safe, script-src
// 'self') vanilla script, not React. The RFC list is corrected to the
// actual repo RFC index (0001-0012) — a standards site must not ship
// wrong spec facts. Exact primitive/fixture counts will be wired from
// core by the sync pipeline (tracked follow-up); structure preserved.

const sections = [
  { id: "overview", label: "Overview" },
  { id: "primitives", label: "Intent primitives" },
  { id: "examples", label: "Code examples" },
  { id: "rfcs", label: "RFCs" },
  { id: "conformance", label: "Conformance suite" },
  { id: "compat", label: "Compatible runtimes" },
  { id: "glossary", label: "Glossary" },
];

const PRIMITIVES = [
  { n: "move_to", profile: "core", sig: "{ frame, pose? }", d: "Move to a named frame or explicit pose. The most-called verb." },
  { n: "dock", profile: "core", sig: "{ station }", d: "Park at a dock or charger. Implies precision alignment." },
  { n: "hover", profile: "core", sig: "{ duration?, station_keep? }", d: "Maintain pose. No horizontal motion. Aerial + marine." },
  { n: "wait", profile: "core", sig: "{ duration }", d: "Idle for a fixed wall-clock duration." },
  { n: "wait_for", profile: "core", sig: "{ condition, timeout? }", d: "Block on a condition (sensor reading, perception event)." },
  { n: "grasp", profile: "core", sig: "{ target, force? }", d: "Close end-effector around a bound target." },
  { n: "release", profile: "core", sig: "{ surface? }", d: "Release the held object. Optional surface placement." },
  { n: "detect", profile: "core", sig: "{ object, frame? } -> bind", d: "Run perception, bind a result for later steps." },
  { n: "scan", profile: "core", sig: "{ region, sensor? }", d: "Sweep a region with a sensor. Structured result." },
  { n: "measure", profile: "core", sig: "{ quantity, target? }", d: "Capture a single measurement (distance, mass, temp...)." },
  { n: "capture", profile: "core", sig: "{ media, target? }", d: "Capture media (image, audio clip, point cloud)." },
  { n: "report", profile: "core", sig: "{ payload, channel? }", d: "Emit a structured report on a declared channel." },
  { n: "speak", profile: "home", sig: "{ text, voice? }", d: "Emit audio via TTS. Home-profile extension." },
  { n: "listen", profile: "home", sig: "{ timeout?, grammar? } -> bind", d: "Capture audio and bind the transcription." },
  { n: "take_off", profile: "drone", sig: "{ altitude }", d: "Transition from grounded to flight." },
  { n: "land", profile: "drone", sig: "{ pad? }", d: "Transition from flight to grounded." },
  { n: "return_to_home", profile: "drone", sig: "{}", d: "Return to the take-off frame. Substrate-implemented." },
];

const RFCS = [
  { id: "RFC-0001", t: "RFC process", s: "accepted" },
  { id: "RFC-0002", t: "Initial primitive vocabulary", s: "accepted" },
  { id: "RFC-0003", t: "US federal alignment as the default", s: "accepted" },
  { id: "RFC-0004", t: "Compliance policy as a DSL", s: "accepted" },
  { id: "RFC-0005", t: "HBOM parsing", s: "accepted" },
  { id: "RFC-0006", t: "Connectivity & link-loss", s: "accepted" },
  { id: "RFC-0007", t: "Manufacturer go-to-market", s: "accepted" },
  { id: "RFC-0008", t: "Community discussions", s: "accepted" },
  { id: "RFC-0009", t: "Legged & humanoid mobility", s: "accepted" },
  { id: "RFC-0010", t: "Whole-body / bimanual manipulation", s: "draft" },
  { id: "RFC-0011", t: "Educational profile", s: "draft" },
  { id: "RFC-0012", t: "Research profile", s: "draft" },
];

const codeBlocks: Record<string, string> = {
  urml: `<span class="c"># program.urml.yaml — bring me the red mug</span>
<span class="k">sequence</span><span class="p">:</span>
  - <span class="k">move_to</span><span class="p">:</span>     { room: kitchen }
  - <span class="k">detect</span><span class="p">:</span>      { object: red_mug, frame: kitchen }
  - <span class="k">grasp</span><span class="p">:</span>       { target: $detected }
  - <span class="k">move_to</span><span class="p">:</span>     { room: living_room }
  - <span class="k">release</span><span class="p">:</span>     { surface: side_table }

<span class="c"># All five passes — executed against mock TurtleBot 4</span>`,
  manifest: `<span class="c"># manifest.yaml — capability declaration</span>
<span class="k">robot</span><span class="p">:</span>     acme-mover-x1
<span class="k">profile</span><span class="p">:</span>   home

<span class="k">capabilities</span><span class="p">:</span>
  - <span class="k">verb</span><span class="p">:</span> move_to
    <span class="k">frames</span><span class="p">:</span> [kitchen, living_room, bedroom]
  - <span class="k">verb</span><span class="p">:</span> grasp
    <span class="k">max_force_n</span><span class="p">:</span> 25

<span class="k">provenance</span><span class="p">:</span>
  <span class="k">controller</span><span class="p">:</span>   { country: US, vendor: Acme }
  <span class="k">vision</span><span class="p">:</span>       { country: US, vendor: Intel }`,
  policy: `<span class="c"># policy.yaml — NDAA 889 / FCC default</span>
<span class="k">policy</span><span class="p">:</span> ndaa-fcc-default
<span class="k">version</span><span class="p">:</span> 2026-05-16

<span class="k">rules</span><span class="p">:</span>
  - <span class="k">id</span><span class="p">:</span> ndaa-889-covered
    <span class="k">when</span><span class="p">:</span>  manifest.provenance.*.country == "CN"
    <span class="k">then</span><span class="p">:</span> reject
    <span class="k">reason</span><span class="p">:</span> "Covered foreign entity (NDAA 889)"

  - <span class="k">id</span><span class="p">:</span> fcc-covered-list
    <span class="k">when</span><span class="p">:</span>  manifest.provenance.*.vendor in fcc.covered
    <span class="k">then</span><span class="p">:</span> reject
    <span class="k">reason</span><span class="p">:</span> "FCC Covered List entity"`,
};
const tabs = [
  { id: "urml", label: "program.urml.yaml" },
  { id: "manifest", label: "manifest.yaml" },
  { id: "policy", label: "policy.yaml" },
];
---

<Base
  title="URML specification — your map to the GitHub source of truth"
  description="The normative URML spec lives on GitHub (Apache-2.0). This page indexes it: the intent primitives, code examples, the RFC list, the conformance suite, and a glossary."
  active="Spec"
>
  <section class="hi-section" style="padding:72px 56px 56px">
    <div class="eyebrow" style="margin-bottom:24px">↳ The specification</div>
    <div style="display:grid;grid-template-columns:1.4fr 1fr;gap:56px;align-items:end">
      <div>
        <h1 class="s" style="max-width:820px">The spec lives on GitHub. This is your map to it.</h1>
        <p class="lead" style="margin-top:24px;max-width:620px">
          <span class="mono" style="background:var(--bone-2);padding:2px 8px;border-radius:3px;font-size:14px">github.com/URML-MARS/URML</span>
          is the normative source of truth. Apache-2.0, DCO-signed. This page indexes the spec,
          gives you per-primitive code, and links you back to the file you want.
        </p>
        <div style="display:flex;gap:12px;margin-top:28px;flex-wrap:wrap;align-items:center">
          <a class="hi-btn primary" href="https://github.com/URML-MARS/URML" rel="noopener noreferrer"><Icon name="git" size={16} /> Read on GitHub →</a>
          <a class="hi-btn outline" href="https://github.com/URML-MARS/URML/blob/main/CHANGELOG.md" rel="noopener noreferrer">Changelog</a>
        </div>
      </div>
      <div class="hi-card" style="padding:22px">
        <div class="eyebrow" style="margin-bottom:10px">Spec version</div>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:14px 16px;border:1px solid var(--ink);border-radius:4px;font-family:var(--mono);font-size:14px;background:var(--bone)">
          <span><strong style="font-family:var(--mono)">v0.1</strong> · DRAFT</span>
          <span style="color:var(--ink-faint)">▾</span>
        </div>
        <hr class="hi-rule" style="margin:14px 0" />
        <div class="body-sm">Spec is versioned per-commit. The v1.0 freeze is targeted later; see GOVERNANCE.md.</div>
      </div>
    </div>
  </section>

  <section style="display:grid;grid-template-columns:240px 1fr;gap:0;border-top:1px solid var(--rule)">
    <aside style="position:sticky;top:0;align-self:start;padding:40px 0 40px 56px;border-right:1px solid var(--rule);background:var(--bone)">
      <div class="eyebrow" style="margin-bottom:18px">Contents</div>
      <nav style="display:grid;gap:2px">
        {sections.map((s, i) => (
          <a href={"#" + s.id} style="display:grid;grid-template-columns:auto 1fr;gap:12px;padding:8px 14px 8px 12px;font-size:14px;color:var(--ink-2);text-decoration:none;scroll-margin-top:20px">
            <span class="mono" style="font-size:11px;color:var(--ink-faint);width:22px">§{i + 1}</span>
            <span>{s.label}</span>
          </a>
        ))}
      </nav>
    </aside>

    <div style="padding:40px 56px">
      <div id="overview" style="padding-bottom:56px;border-bottom:1px solid var(--rule);scroll-margin-top:20px">
        <div class="caption" style="margin-bottom:12px">§1 · OVERVIEW</div>
        <h2 class="s">A small, opinionated language.</h2>
        <p class="body" style="margin-top:18px;max-width:720px">
          URML programs are YAML — a tree of intent primitives composed with
          <span class="mono"> sequence</span>, <span class="mono">branch</span>, <span class="mono">parallel</span>,
          <span class="mono"> retry</span>, and <span class="mono">on_error</span>. The runtime translates
          intent into substrate calls; the validator refuses any program that cannot satisfy all five passes.
        </p>
      </div>

      <div id="primitives" style="padding:56px 0;border-bottom:1px solid var(--rule);scroll-margin-top:20px">
        <div style="display:flex;justify-content:space-between;align-items:end;margin-bottom:8px">
          <div>
            <div class="caption" style="margin-bottom:12px">§2 · INTENT PRIMITIVES</div>
            <h2 class="s">The verb vocabulary.</h2>
          </div>
          <div style="display:flex;gap:8px">
            <span class="hi-chip">core · 12</span>
            <span class="hi-chip">home · 2</span>
            <span class="hi-chip">drone · 3</span>
          </div>
        </div>
        <p class="body" style="max-width:720px;margin-top:8px;margin-bottom:28px">
          Every URML-compatible runtime must implement the core set. Profile extensions are optional
          and declared in the manifest.
        </p>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px">
          {PRIMITIVES.map((p) => (
            <div class="hi-card" style="padding:20px">
              <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px">
                <span class="mono" style="font-size:16px;font-weight:600">{p.n}</span>
                <span class="mono" style={"font-size:10px;letter-spacing:0.08em;text-transform:uppercase;color:" + (p.profile === "core" ? "var(--ink-faint)" : "var(--accent)")}>{p.profile}</span>
              </div>
              <div class="mono" style="font-size:12px;color:var(--ink-soft);margin-bottom:10px;background:var(--bone-2);padding:6px 10px;border-radius:3px">{p.sig}</div>
              <p style="font-size:13px;color:var(--ink-2);line-height:1.5;margin:0">{p.d}</p>
            </div>
          ))}
        </div>
      </div>

      <div id="examples" style="padding:56px 0;border-bottom:1px solid var(--rule);scroll-margin-top:20px">
        <div class="caption" style="margin-bottom:12px">§3 · CODE EXAMPLES</div>
        <h2 class="s">A program, a manifest, a policy.</h2>
        <p class="body" style="max-width:720px;margin-top:18px;margin-bottom:28px">
          These three files are all you need to validate and execute. The program says what; the
          manifest says what the robot can; the policy says what the jurisdiction allows.
        </p>
        <div class="hi-card" style="padding:0;overflow:hidden">
          <div id="codetabs" style="display:flex;border-bottom:1px solid var(--rule);background:var(--bone-2)">
            {tabs.map((t, i) => (
              <button
                type="button"
                data-tab={t.id}
                aria-pressed={i === 0 ? "true" : "false"}
                style="padding:12px 22px;background:transparent;border:0;border-bottom:2px solid transparent;font-family:var(--mono);font-size:12px;letter-spacing:0.04em;color:var(--ink-soft);cursor:pointer"
              >{t.label}</button>
            ))}
            <div style="flex:1"></div>
            <a class="hi-btn ghost" href="https://github.com/URML-MARS/URML" rel="noopener noreferrer" style="padding:8px 18px;font-size:13px;color:var(--ink-soft)"><Icon name="git" size={14} /> View on GitHub</a>
          </div>
          {tabs.map((t, i) => (
            <div class="hi-code" data-panel={t.id} style={"border-radius:0;" + (i === 0 ? "" : "display:none")}><Fragment set:html={codeBlocks[t.id]} /></div>
          ))}
        </div>
      </div>

      <div id="rfcs" style="padding:56px 0;border-bottom:1px solid var(--rule);scroll-margin-top:20px">
        <div style="display:flex;justify-content:space-between;align-items:end;margin-bottom:8px">
          <div>
            <div class="caption" style="margin-bottom:12px">§4 · RFCs</div>
            <h2 class="s">Nine accepted, three open.</h2>
          </div>
          <a class="hi-btn outline" href="https://github.com/URML-MARS/URML/tree/main/docs/rfcs" rel="noopener noreferrer"><Icon name="git" size={14} /> RFC repo →</a>
        </div>
        <div style="margin-top:24px;border-top:1px solid var(--rule)">
          {RFCS.map((r) => (
            <a href="https://github.com/URML-MARS/URML/tree/main/docs/rfcs" rel="noopener noreferrer" style="display:grid;grid-template-columns:120px 1fr 100px 24px;gap:20px;align-items:center;padding:16px 0;border-bottom:1px solid var(--rule);text-decoration:none;color:inherit">
              <span class="mono" style="font-size:13px;color:var(--accent);font-weight:600">{r.id}</span>
              <span style="font-size:15px;color:var(--ink)">{r.t}</span>
              <span class="mono" style={"font-size:10px;letter-spacing:0.08em;text-transform:uppercase;text-align:right;color:" + (r.s === "accepted" ? "var(--accent)" : r.s === "review" ? "#a64321" : "var(--ink-faint)")}>{r.s}</span>
              <span style="color:var(--ink-faint);text-align:right">↗</span>
            </a>
          ))}
        </div>
      </div>

      <div id="conformance" style="padding:56px 0;border-bottom:1px solid var(--rule);scroll-margin-top:20px">
        <div class="caption" style="margin-bottom:12px">§5 · CONFORMANCE SUITE</div>
        <h2 class="s">Declarative fixtures.</h2>
        <p class="body" style="max-width:720px;margin-top:18px;margin-bottom:24px">
          Any URML-compatible runtime must pass the public conformance suite. Fixtures are YAML,
          hermetic, and produce a machine-readable results file — the artifact you submit for listing.
          See <span class="mono">conformance/CONFORMANCE_KIT.md</span>.
        </p>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px">
          {[["home","speak / listen / room frames"],["drone","take_off / hover / RTH / envelope"],["industrial","dock / measure / report"],["quadruped + biped","legged / humanoid mobility"]].map(([cat, sub]) => (
            <div class="hi-card tint" style="padding:18px">
              <div class="caption" style="color:var(--accent);margin-bottom:8px">{cat}</div>
              <div class="body-sm" style="margin-top:8px">{sub}</div>
            </div>
          ))}
        </div>
      </div>

      <div id="compat" style="padding:56px 0;border-bottom:1px solid var(--rule);scroll-margin-top:20px">
        <div class="caption" style="margin-bottom:12px">§6 · COMPATIBLE RUNTIMES</div>
        <h2 class="s">Reference adapters, more welcome.</h2>
        <p class="body" style="max-width:720px;margin-top:18px;margin-bottom:24px">
          The repo ships reference adapters across ROS 2, MAVLink, and vendor SDKs. Self-report your
          own by running the conformance kit and opening a PR.
        </p>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px">
          {[
            { t: "ros2-runtime", sub: "ROS 2 · Nav2 / MoveIt 2 / vision_msgs" },
            { t: "px4-runtime", sub: "PX4 / MAVLink via pymavlink (zero ROS)" },
            { t: "industrial-arm-runtime", sub: "16 brands · ABB · FANUC · KUKA · YASKAWA · UR · Franka · Kawasaki · Stäubli · Comau · Mitsubishi · Denso · Hyundai · Nachi · Epson · Omron · Hanwha · (Move #1 mapping RFCs 0023–0030 filed: Yaskawa / UR / KUKA / Stäubli / Mitsubishi / FANUC / Kawasaki / Denso)" },
            { t: "cobot-runtime", sub: "8 brands · UR RTDE · Franka FCI · Doosan DRFL · Techman TMflow · Kinova Kortex · Mecademic · Neura · Kassow (zero ROS)" },
            { t: "legged / humanoid / mobile / marine", sub: "Spot · ANYmal · Digit · Husky · Jackal · BlueROV2" },
            { t: "opcua-runtime", sub: "OPC UA Robotics via asyncua (zero ROS) · RFC-0015/0016 spec-gaps filed" },
            { t: "mujoco-runtime / isaac-runtime", sub: "Physics sims · zero ROS · Isaac needs local RTX/Omniverse (not cloud)" },
            { t: "embedded-runtime / edu-runtime", sub: "micro:bit · Arduino · VEX V5 · LEGO SPIKE · Thymio (RFC-0011 educational)" },
            { t: "autosar-runtime", sub: "AUTOSAR Adaptive ara::com scaffold · zero ROS · RFC-0019 Draft binding" },
          ].map((a) => (
            <div class="hi-card" style="padding:22px">
              <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px">
                <span class="mono" style="font-size:15px;font-weight:600">{a.t}</span>
                <span class="caption" style="color:var(--accent)">✓ HERMETIC</span>
              </div>
              <div class="body-sm">{a.sub}</div>
            </div>
          ))}
        </div>
      </div>

      <div id="glossary" style="padding:56px 0 24px;scroll-margin-top:20px">
        <div class="caption" style="margin-bottom:12px">§7 · GLOSSARY</div>
        <h2 class="s">Words we use precisely.</h2>
        <div style="margin-top:24px">
          {[
            ["Capability", "A declared ability in the manifest. The validator checks every verb against the declared set."],
            ["Envelope", "The active safety boundary at deployment. Geofence, altitude bands, people-occupancy zones."],
            ["Manifest", "YAML declaring what a robot can do and where every covered component comes from."],
            ["Policy", "YAML rules pass 5 evaluates the manifest against. Jurisdiction-defined."],
            ["Profile", "A bundle of extensions. Today: home, drone, industrial, educational, research."],
            ["Substrate", "What URML sits on top of. ROS 2, PX4, OPC UA. NOT part of URML."],
          ].map(([t, d]) => (
            <div style="display:grid;grid-template-columns:200px 1fr;gap:24px;padding:14px 0;border-bottom:1px dashed var(--rule)">
              <span class="mono" style="font-size:14px;font-weight:600">{t}</span>
              <span class="body-sm" style="color:var(--ink-2)">{d}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="hi-section dark" style="padding:72px 56px">
    <div style="display:grid;grid-template-columns:1.4fr 1fr;gap:56px;align-items:center">
      <h2 style="color:var(--bone)">The spec is on GitHub. The working group is here.</h2>
      <div style="display:flex;flex-direction:column;gap:12px">
        <a class="hi-btn primary lg" href="https://github.com/URML-MARS/URML" rel="noopener noreferrer" style="justify-content:center"><Icon name="git" size={16} /> Read on GitHub →</a>
        <a class="hi-btn outline-on-dark lg" href="/governance" style="justify-content:center">Open an RFC</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Code-tabs island. Astro bundles this to an external module
  // (script-src 'self' safe — no inline script, no third-party).
  const root = document.getElementById("codetabs");
  if (root) {
    const btns = root.querySelectorAll<HTMLButtonElement>("button[data-tab]");
    const panels = document.querySelectorAll<HTMLElement>("[data-panel]");
    btns.forEach((b) => {
      b.addEventListener("click", () => {
        const id = b.dataset.tab;
        btns.forEach((x) => {
          const on = x === b;
          x.setAttribute("aria-pressed", on ? "true" : "false");
          x.style.background = on ? "var(--bone)" : "transparent";
          x.style.color = on ? "var(--ink)" : "var(--ink-soft)";
          x.style.borderBottomColor = on ? "var(--accent)" : "transparent";
          x.style.fontWeight = on ? "500" : "400";
        });
        panels.forEach((p) => {
          p.style.display = p.dataset.panel === id ? "" : "none";
        });
      });
    });
  }
</script>
